const { google } = require('googleapis');

const SPREADSHEET_ID = process.env.GOOGLE_SPREADSHEET_ID;
const SERVICE_ACCOUNT_EMAIL = process.env.GOOGLE_SERVICE_ACCOUNT_EMAIL;
const PRIVATE_KEY = process.env.GOOGLE_PRIVATE_KEY ? process.env.GOOGLE_PRIVATE_KEY.replace(/\\n/g, '\n') : null;

function getSheetsClient() {
  if (!SPREADSHEET_ID || !SERVICE_ACCOUNT_EMAIL || !PRIVATE_KEY) {
    throw new Error('Missing Google Sheets env variables. Please configure GOOGLE_SPREADSHEET_ID, GOOGLE_SERVICE_ACCOUNT_EMAIL and GOOGLE_PRIVATE_KEY.');
  }

  const auth = new google.auth.GoogleAuth({
    credentials: {
      client_email: SERVICE_ACCOUNT_EMAIL,
      private_key: PRIVATE_KEY
    },
    scopes: ['https://www.googleapis.com/auth/spreadsheets']
  });

  return google.sheets({ version: 'v4', auth });
}

async function ensureSheets() {
  const sheets = getSheetsClient();
  const spreadsheet = await sheets.spreadsheets.get({ spreadsheetId: SPREADSHEET_ID });
  const existingTitles = spreadsheet.data.sheets.map((sheet) => sheet.properties.title);
  const sheetsToCreate = [
    {
      name: 'Members',
      headers: ['PSEUDO', 'EMAIL', 'TANK', 'AVION', 'MISSILE', 'TOTAL', 'T11', 'LAST_UPDATED', 'CREATED_AT']
    },
    {
      name: 'History',
      headers: ['DATE', 'PSEUDO', 'TANK', 'AVION', 'MISSILE', 'TOTAL', 'T11']
    },
    {
      name: 'PendingMembers',
      headers: ['PSEUDO', 'EMAIL', 'CODE', 'EXPIRES_AT', 'CREATED_AT', 'USED']
    },
    {
      name: 'Config',
      headers: ['KEY', 'VALUE']
    }
  ];

  for (const sheet of sheetsToCreate) {
    if (!existingTitles.includes(sheet.name)) {
      await sheets.spreadsheets.batchUpdate({
        spreadsheetId: SPREADSHEET_ID,
        requestBody: {
          requests: [
            {
              addSheet: {
                properties: { title: sheet.name }
              }
            }
          ]
        }
      });
    }

    const rows = await readSheet(sheet.name);
    if (!rows.length) {
      await appendRange(sheet.name, [sheet.headers]);
    } else if (rows[0].join(',') !== sheet.headers.join(',')) {
      await writeRange(sheet.name, 'A1', [sheet.headers]);
    }
  }
}

async function readSheet(sheetName) {
  const sheets = getSheetsClient();
  const response = await sheets.spreadsheets.values.get({
    spreadsheetId: SPREADSHEET_ID,
    range: `'${sheetName}'!A:Z`
  });
  return response.data.values || [];
}

async function appendRange(sheetName, values) {
  const sheets = getSheetsClient();
  await sheets.spreadsheets.values.append({
    spreadsheetId: SPREADSHEET_ID,
    range: `'${sheetName}'!A1`,
    valueInputOption: 'RAW',
    insertDataOption: 'INSERT_ROWS',
    requestBody: { values }
  });
}

async function writeRange(sheetName, range, values) {
  const sheets = getSheetsClient();
  await sheets.spreadsheets.values.update({
    spreadsheetId: SPREADSHEET_ID,
    range: `'${sheetName}'!${range}`,
    valueInputOption: 'RAW',
    requestBody: { values }
  });
}

function parseRow(headers, row) {
  const obj = {};
  headers.forEach((header, index) => {
    obj[header.toLowerCase()] = row[index] || '';
  });
  return obj;
}

function getHeaderIndex(headers, name) {
  return headers.indexOf(name.toUpperCase());
}

async function getMembers() {
  const rows = await readSheet('Members');
  if (!rows.length) return [];

  const headers = rows[0];
  return rows.slice(1).map((row) => parseRow(headers, row)).map((item) => ({
    pseudo: item.pseudo || '',
    email: item.email || '',
    tank: Number(item.tank || 0),
    avion: Number(item.avion || 0),
    missile: Number(item.missile || 0),
    total: Number(item.total || 0),
    t11: item.t11 || 'Non',
    last_updated: item.last_updated || '',
    created_at: item.created_at || ''
  }));
}

async function findMemberByPseudo(pseudo) {
  const members = await getMembers();
  return members.find((member) => String(member.pseudo).toLowerCase() === String(pseudo).toLowerCase()) || null;
}

async function saveMember(member) {
  const rows = await readSheet('Members');
  const headers = rows[0] || ['PSEUDO', 'EMAIL', 'TANK', 'AVION', 'MISSILE', 'TOTAL', 'T11', 'LAST_UPDATED', 'CREATED_AT'];
  const targetPseudo = String(member.pseudo || '').trim();
  const email = String(member.email || '').trim();
  const tank = Number(member.tank || 0);
  const avion = Number(member.avion || 0);
  const missile = Number(member.missile || 0);
  const total = Number(member.total || tank + avion + missile);
  const t11 = member.t11 === 'Oui' || member.t11 === true ? 'Oui' : 'Non';
  const lastUpdated = new Date().toISOString();

  const rowData = [targetPseudo, email, String(tank), String(avion), String(missile), String(total), t11, lastUpdated, ''];

  let foundIndex = -1;
  rows.slice(1).forEach((row, index) => {
    if (String(row[0] || '').toLowerCase() === targetPseudo.toLowerCase() && foundIndex === -1) {
      foundIndex = index + 1;
    }
  });

  if (foundIndex !== -1) {
    const range = `'Members'!A${foundIndex + 1}:I${foundIndex + 1}`;
    await writeRange('Members', range, [rowData]);
    return;
  }

  await appendRange('Members', [rowData]);
}

async function appendHistory(entry) {
  const rows = await readSheet('History');
  const headers = rows[0] || ['DATE', 'PSEUDO', 'TANK', 'AVION', 'MISSILE', 'TOTAL', 'T11'];
  const row = [
    entry.date || new Date().toISOString(),
    String(entry.pseudo || '').trim(),
    String(entry.tank || 0),
    String(entry.avion || 0),
    String(entry.missile || 0),
    String(entry.total || 0),
    entry.t11 === 'Oui' ? 'Oui' : 'Non'
  ];

  if (!rows.length) {
    await writeRange('History', 'A1', [headers]);
  }

  await appendRange('History', [row]);
}

async function getHistory() {
  const rows = await readSheet('History');
  if (!rows.length) return [];
  const headers = rows[0];
  return rows.slice(1).map((row) => parseRow(headers, row)).map((item) => ({
    date: item.date || '',
    pseudo: item.pseudo || '',
    tank: Number(item.tank || 0),
    avion: Number(item.avion || 0),
    missile: Number(item.missile || 0),
    total: Number(item.total || 0),
    t11: item.t11 || 'Non'
  }));
}

async function savePendingMember({ pseudo, email, code, expiresAt, createdAt, used }) {
  const rows = await readSheet('PendingMembers');
  if (!rows.length) {
    await writeRange('PendingMembers', 'A1', [['PSEUDO', 'EMAIL', 'CODE', 'EXPIRES_AT', 'CREATED_AT', 'USED']]);
  }

  const normalizedPseudo = String(pseudo || '').trim();
  const normalizedEmail = String(email || '').trim();
  const row = [normalizedPseudo, normalizedEmail, String(code), expiresAt, createdAt, used ? 'true' : 'false'];
  await appendRange('PendingMembers', [row]);
}

async function getPendingMember(email, code) {
  const rows = await readSheet('PendingMembers');
  if (!rows.length) return null;

  const headers = rows[0];
  const findings = rows.slice(1).map((row) => parseRow(headers, row));

  const match = findings.find((row) => {
    const sameEmail = String(row.email || '').toLowerCase() === String(email || '').toLowerCase();
    const sameCode = String(row.code || '').trim() === String(code || '').trim();
    const stillValid = !row.expires_at || new Date(row.expires_at) > new Date();
    const notUsed = String(row.used || '').toLowerCase() !== 'true';
    return sameEmail && sameCode && stillValid && notUsed;
  });

  return match || null;
}

async function markPendingMemberAsUsed(email, pseudo) {
  const rows = await readSheet('PendingMembers');
  if (!rows.length) return;

  const headers = rows[0];
  const indexMap = rows.slice(1).findIndex((row) => String(row[0] || '').trim().toLowerCase() === String(pseudo || '').trim().toLowerCase() && String(row[1] || '').trim().toLowerCase() === String(email || '').trim().toLowerCase());
  if (indexMap === -1) return;

  const targetRowIndex = indexMap + 2;
  const values = rows.slice(1)[indexMap];
  values[5] = 'true';
  await writeRange('PendingMembers', `F${targetRowIndex}:F${targetRowIndex}`, [[values[5]]]);
}

async function getConfigValue(key) {
  const rows = await readSheet('Config');
  if (!rows.length) return null;
  const headers = rows[0];
  const targetIdx = getHeaderIndex(headers, 'KEY');
  const valueIdx = getHeaderIndex(headers, 'VALUE');

  const result = rows.slice(1).find((row) => String(row[targetIdx] || '').toLowerCase() === String(key).toLowerCase());
  return result ? result[valueIdx] : null;
}

async function setConfigValue(key, value) {
  const rows = await readSheet('Config');
  const headers = rows[0] || ['KEY', 'VALUE'];
  const mapIdx = rows.slice(1).findIndex((row) => String(row[0] || '').toLowerCase() === String(key).toLowerCase());

  if (!rows.length) {
    await writeRange('Config', 'A1', [headers]);
  }

  if (mapIdx !== -1) {
    const rowNumber = mapIdx + 2;
    await writeRange('Config', `A${rowNumber}:B${rowNumber}`, [[key, String(value)]]);
    return;
  }

  await appendRange('Config', [[key, String(value)]]);
}

module.exports = {
  ensureSheets,
  getMembers,
  saveMember,
  appendHistory,
  getHistory,
  savePendingMember,
  getPendingMember,
  markPendingMemberAsUsed,
  getConfigValue,
  setConfigValue,
  findMemberByPseudo
};
