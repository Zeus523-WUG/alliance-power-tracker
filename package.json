<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Créer un membre</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="auth-body">
    <main class="auth-card">
      <h1>Créer un nouveau membre</h1>

      <% if (error) { %>
        <div class="alert error"><%= error %></div>
      <% } %>

      <form method="POST" action="/register">
        <label for="pseudo">Pseudo</label>
        <input id="pseudo" name="pseudo" type="text" required placeholder="Ex: Zeus" />

        <label for="email">Adresse e-mail</label>
        <input id="email" name="email" type="email" required placeholder="adresse@mail.fr" />

        <button type="submit">Recevoir le code</button>
      </form>

      <div class="link-row">
        <a href="/login">Retour à la connexion</a>
      </div>
    </main>
  </body>
</html>
